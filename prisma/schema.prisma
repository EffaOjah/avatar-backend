generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// =======================
// ENUMS
// =======================

enum Role {
  CUSTOMER
  BUSINESS
  RIDER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  OPS_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  MODERATION_ADMIN
}

enum AdminStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  REFUND
  WALLET_ADJUSTMENT
  PAYOUT_BATCH
  ADMIN_ROLE_CHANGE
  ADMIN_DEACTIVATION
  RIDER_PERMANENT_SUSPENSION
  BUSINESS_PERMANENT_SUSPENSION
  ORDER_STATUS_OVERRIDE
}

enum IncidentType {
  LATE_DELIVERY
  FAILED_DELIVERY
  RIDER_NO_SHOW
  ACCIDENT
  ITEM_MISSING
  SUSPECTED_FRAUD
}

enum IncidentStatus {
  OPEN
  ASSIGNED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  ESCALATED
  RESOLVED
  CLOSED
}

enum WalletStatus {
  ACTIVE
  FROZEN
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum RefundDestination {
  WALLET
  ORIGINAL_PAYMENT
}

enum PayoutBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutLineStatus {
  PENDING
  SUBMITTED
  SUCCESS
  FAILED
  EXCLUDED
}

enum ReconciliationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationFlagType {
  MISSING_IN_LEDGER
  MISSING_IN_PAYSTACK
  AMOUNT_MISMATCH
  STATUS_MISMATCH
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiderStatus {
  OFFLINE
  ONLINE
}

// =======================
// CORE & USERS
// =======================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  role      Role
  isActive  Boolean  @default(false)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business             Business?
  rider                Rider?
  addresses            Address[]
  carts                Cart[]
  orders               Order[]
  wallets              Wallet[]
  verificationRecords  VerificationRecord[]
  notifications        Notification[]
}

model Business {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  slug               String             @unique
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  locationLat        Float?
  locationLng        Float?
  address            String?
  verificationStatus VerificationStatus @default(PENDING)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products           Product[]
  orders             Order[]
}

model Rider {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             RiderStatus        @default(OFFLINE)
  verificationStatus VerificationStatus @default(PENDING)
  lastLocationLat    Float?
  lastLocationLng    Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  deliveries         Delivery[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  city      String
  state     String
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

// =======================
// COMMERCE
// =======================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Float
  inventory   Int      @default(0)
  variants    Json?    // e.g., [{ "color": "Red", "size": "L" }]
  isAvailable Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Cart {
  id        String   @id @default(uuid())
  userId    String?  // Nullable for guest carts
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestId   String?  @unique // Session ID for guest carts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

// =======================
// ORDERS & DELIVERY
// =======================

model Order {
  id             String      @id @default(uuid())
  customerId     String
  customer       User        @relation(fields: [customerId], references: [id])
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id])
  addressId      String
  address        Address     @relation(fields: [addressId], references: [id])
  status         OrderStatus @default(PENDING_PAYMENT)
  itemsTotal     Float
  deliveryFee    Float
  totalAmount    Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]
  payment        Payment?
  delivery       Delivery?
  refunds        Refund[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  priceAtOrder Float    // Snapshot of price at the time of order
  createdAt    DateTime @default(now())
}

model Delivery {
  id                   String    @id @default(uuid())
  orderId              String    @unique
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId              String?
  rider                Rider?    @relation(fields: [riderId], references: [id], onDelete: SetNull)
  pinHash              String?
  pinRegenerationCount Int       @default(0)  // Max 3 regenerations per order (OP-03)
  failedAttempts       Int       @default(0)
  deliveryZone         String?   // Zone for OP-01 filtering
  claimLockedAt        DateTime? // Distributed claim lock marker (OP-03)
  claimLockedBy        String?   // Rider/admin that holds the lock
  pickupTime           DateTime?
  dropoffTime          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// =======================
// FINANCE & PAYMENTS
// =======================

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  provider      String   @default("PAYSTACK")
  reference     String   @unique
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float         @default(0.0)
  heldBalance  Float         @default(0.0)
  currency     String        @default("NGN")
  status       WalletStatus  @default(ACTIVE)
  frozenReason String?
  frozenAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  withdrawals   Withdrawal[]
  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([status])
}

model LedgerEntry {
  id             String           @id @default(uuid())
  walletId       String?
  wallet         Wallet?          @relation(fields: [walletId], references: [id], onDelete: SetNull)
  direction      LedgerDirection  @default(CREDIT)
  type           String           // ORDER_DELIVERY_CREDIT, PLATFORM_COMMISSION, WITHDRAWAL, REFUND, WALLET_ADJUSTMENT, PAYOUT
  amount         Float
  currency       String           @default("NGN")
  reference      String?          // Unique payment/transaction or internal ref
  referenceId    String?          // ID of related Order, Withdrawal, etc.
  idempotencyKey String?          @unique
  relatedEntryId String?          // For reversing or paired double entries
  description    String?
  createdAt      DateTime         @default(now())

  @@index([walletId])
  @@index([type])
  @@index([reference])
  @@index([createdAt])
}

model Withdrawal {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Refund {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String            @default("NGN")
  reason         String
  status         RefundStatus      @default(PENDING)
  destination    RefundDestination @default(WALLET)
  requestedBy    String            // AdminUser.id or "CUSTOMER" / "SYSTEM"
  decidedBy      String?           // AdminUser.id
  evidence       String?           // Note or image URL
  decisionReason String?
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([requestedBy])
}

model PayoutBatch {
  id          String            @id @default(uuid())
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float             @default(0.0)
  currency    String            @default("NGN")
  status      PayoutBatchStatus @default(DRAFT)
  approvedBy  String?           // AdminUser.id (Super Admin or checker)
  approvedAt  DateTime?
  createdBy   String            // AdminUser.id
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lines       PayoutLine[]

  @@index([status])
  @@index([periodStart, periodEnd])
}

model PayoutLine {
  id            String           @id @default(uuid())
  batchId       String
  batch         PayoutBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recipientType String           // "BUSINESS" | "RIDER"
  recipientId   String           // Business.id or Rider.id
  amount        Float
  currency      String           @default("NGN")
  status        PayoutLineStatus @default(PENDING)
  paystackRef   String?          @unique
  failureReason String?
  retryCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([batchId, recipientId])
  @@index([batchId])
  @@index([status])
  @@index([recipientId])
}

model ReconciliationRun {
  id                 String               @id @default(uuid())
  periodStart        DateTime
  periodEnd          DateTime
  status             ReconciliationStatus @default(RUNNING)
  totalProcessed     Int                  @default(0)
  totalDiscrepancies Int                  @default(0)
  notes              String?
  initiatedBy        String               // AdminUser.id
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  flags              ReconciliationFlag[]

  @@index([status])
  @@index([createdAt])
}

model ReconciliationFlag {
  id             String                 @id @default(uuid())
  runId          String
  run            ReconciliationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  type           ReconciliationFlagType
  reference      String                 // Paystack or order reference
  paystackAmount Float?
  ledgerAmount   Float?
  description    String
  resolved       Boolean                @default(false)
  resolutionNote String?
  resolvedBy     String?                // AdminUser.id
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([runId])
  @@index([resolved])
}

model ExportJob {
  id          String          @id @default(uuid())
  type        String          // FINANCE_DAILY_SETTLEMENT, COMMISSIONS, PAYOUTS, REFUNDS, WALLET_LIABILITIES, TAX_SUMMARY
  format      String          // CSV, XLSX, PDF
  filters     String?         // JSON stringified filters
  status      ExportJobStatus @default(PENDING)
  fileUrl     String?
  requestedBy String          // AdminUser.id
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([requestedBy])
}

// =======================
// OPERATIONS
// =======================

model VerificationRecord {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType String             // ID_CARD, PASSPORT, SELFIE, VEHICLE_REG
  documentUrl  String             // S3 reference
  status       VerificationStatus @default(PENDING)
  reviewNotes  String?
  reviewedBy   String?            // Admin user ID
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // EMAIL, IN_APP
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "refund.approve", "user.suspend"
  actorId     String   // admin_user.id or user.id
  actorRole   String?  // role at the time of action
  entityType  String?  // e.g. "User", "Order", "Business"
  entityId    String?
  before      String?  // JSON snapshot (sensitive fields redacted)
  after       String?  // JSON snapshot
  reason      String?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([entityId])
  @@index([createdAt])
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // Stored as string, cast as needed
  updatedAt DateTime @updatedAt
}

// =======================
// OPERATIONS (OP-07)
// =======================

model Incident {
  id          String         @id @default(uuid())
  type        IncidentType
  status      IncidentStatus @default(OPEN)
  orderId     String?        // Linked order (optional)
  riderId     String?        // Linked rider (optional)
  businessId  String?        // Linked business (optional)
  description String
  notes       String?        // Internal notes (append-only via service)
  ownerId     String?        // AdminUser.id assigned as owner
  resolvedAt  DateTime?
  reportedBy  String         // AdminUser.id who logged it
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([riderId])
  @@index([reportedBy])
}

model Dispute {
  id              String        @id @default(uuid())
  status          DisputeStatus @default(OPEN)
  orderId         String?
  customerId      String?       // User.id of complainant
  description     String
  resolution      String?
  ownerId         String?       // AdminUser.id
  refundRequestId String?       // Set when money movement is needed
  escalatedTo     String?       // "FINANCE" | "MODERATION" | "SUPER_ADMIN"
  reportedBy      String        // AdminUser.id
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([customerId])
}

// =======================
// ADMIN CONSOLE
// =======================

model AdminUser {
  id             String      @id @default(uuid())
  email          String      @unique
  name           String
  role           AdminRole
  status         AdminStatus @default(INVITED)
  passwordHash   String?
  mfaSecret      String?     // Encrypted at rest
  mfaEnabled     Boolean     @default(false)
  lastLoginAt    DateTime?
  createdBy      String?     // AdminUser.id who invited this admin
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  sessions       AdminSession[]
  approvalsMade  ApprovalRequest[] @relation("ApprovalRequester")
  approvalsGiven ApprovalRequest[] @relation("ApprovalDecider")

  @@index([email])
  @@index([role])
  @@index([status])
}

model AdminSession {
  id          String    @id @default(uuid())
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshHash String
  familyId    String    // For rotation detection (refresh token family)
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId])
  @@index([familyId])
}

model ApprovalRequest {
  id             String         @id @default(uuid())
  type           ApprovalType
  payload        String         // JSON with context for the approver
  requestedBy    String
  requester      AdminUser      @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  status         ApprovalStatus @default(PENDING)
  decidedBy      String?
  decider        AdminUser?     @relation("ApprovalDecider", fields: [decidedBy], references: [id])
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([requestedBy])
  @@index([type])
}

// =======================
// AUTHENTICATION
// =======================

model OtpCode {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
